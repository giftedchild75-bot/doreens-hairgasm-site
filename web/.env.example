# Copy to .env.local for local work; set the same names in Vercel for production.
# Never commit real values.

# --- Required ---
DATABASE_URL=pglite:./.data/dev          # production: postgres://… (Neon, Supabase, etc.)
DATABASE_POOL_MAX=5
SITE_URL=http://localhost:3000            # production: https://your-domain
ORDER_LINK_SECRET=change-me-to-a-long-random-string

# --- Payments (Paystack) — off until PAYMENTS_ENABLED=true ---
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=                      # sk_test_… first; sk_live_… also needs the line below
PAYSTACK_LIVE_APPROVED=false

# --- Continue with Google — the button stays hidden until both are set ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta Pixel — off until set; loads only after the visitor accepts the banner ---
META_PIXEL_ID=

# --- Email (Resend) — emails are queued but not sent until set ---
RESEND_API_KEY=
EMAIL_FROM=                               # e.g. Doreen's Hairgasm <orders@your-domain>
STORE_NOTIFY_EMAIL=                       # where new-order alerts go

# --- Other ---
WHATSAPP_NUMBER=2349130213524
STOCK_RESERVATION_MINUTES=60
CRON_SECRET=                              # protects /api/cron/expire
BLOB_READ_WRITE_TOKEN=                    # Vercel Blob for admin photo uploads; local disk if unset
